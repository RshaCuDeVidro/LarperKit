// neon — o mesmo kit, restilizado só com `parts`: cada pedaço muda por estado.
theme "neon" description="Partes com estados." description-en="Parts with states."

colors {
    bg       "#0b0614"
    rail     "#08040f"
    sidebar  "#110a1f"
    surface  "#140c24"
    elevated "#1c1233"
    overlay  "#1c1233"
    text     "#f3e9ff"
    muted    "#b39ad6"
    faint    "#7a63a0"
    accent   "#ff3ea5"
    accent-text "#1a0010"
    border   "alpha(#ff3ea5, 0.22)"
    hover    "alpha(#f3e9ff, 0.07)"
    selected "alpha(#ff3ea5, 0.2)"
    danger   "#ff6b3e"
    online   "#28f1ff"
    idle     "#ffd23e"
}

fonts ui="Inter" mono="JetBrains Mono" size=16
metrics radius=6

parts {
    part "button" bg="mix(@accent, #7a3cff, 0.35)" radius=64
    part "button:hover" bg="#28f1ff" color="#0b0614" border="#ffffff" border-width=2
    part "button.soft" bg="alpha(#28f1ff, 0.08)" border="#28f1ff" color="#28f1ff" radius=64
    part "toggle:on" bg="#28f1ff"
    part "toggle.knob:on" bg="#0b0614" color="#28f1ff"
    part "slider.fill" bg="#28f1ff" radius=64
    part "slider.track" radius=64
    part "slider.knob" bg="#ff3ea5" radius=64
    part "segment" radius=64
    part "segment:selected" bg="alpha(#28f1ff, 0.18)" border="#28f1ff" border-width=2 color="#ffffff"
    part "segment:hover" bg="alpha(#ff3ea5, 0.14)"
}

layout {
    stack gradient="#0b0614 #1a0a2a" {
        waves color="alpha(@accent, 0.18)" color2="alpha(#28f1ff, 0.14)" seed=2
        spacer
    }
}

// Exemplo para os testes: as entradas de i18n/ru.kdl do larperCord que os testes de
// src/ui/i18n.zig usam.
language "Русский" code="ru" english="Russian"

"a '}' is missing" "a '}' is missing"
"a /* comment that isn't closed" "a /* comment that isn't closed"
"a plural form is a text in quotes" "a plural form is a text in quotes"
"a text that isn't closed" "a text that isn't closed"
"an extra '}'" "an extra '}'"
"code: letters, digits and -, up to 15 (\"ja\", \"pt-PT\")" "code: letters, digits and -, up to 15 (\"ja\", \"pt-PT\")"
"direction: \"ltr\" or \"rtl\"" "direction: \"ltr\" or \"rtl\""
"expected \"English\" \"translation\"" "expected \"English\" \"translation\""
"expected a name" "expected a name"
"expected direction \"ltr\" or \"rtl\"" "expected direction \"ltr\" or \"rtl\""
"expected font-script \"ja\"" "expected font-script \"ja\""
"expected language \"Name\" code=\"xx\"" "expected language \"Name\" code=\"xx\""
"expected plurals \"ru\"" "expected plurals \"ru\""
"font-script: a code like \"ja\", \"zh\" or \"ko\"" "font-script: a code like \"ja\", \"zh\" or \"ko\""
"invalid escape" "invalid escape"
"invalid number" "invalid number"
"Language" "Язык"
"number too long" "number too long"
"plurals: a language code the app knows" "plurals: a language code the app knows"
"Replying to {s}" "Ответ пользователю {s}"
"Sign in" "Войти"
"the language name is empty" "the language name is empty"
"Today at {s}" "Сегодня в {s}"
"too many nested blocks" "too many nested blocks"
"unknown plural form (zero, one, two, few, many or other)" "unknown plural form (zero, one, two, few, many or other)"
"until {1d:0>2}/{0d:0>2} {2s}" "до {1}.{0} {2}"
"Yesterday at {s}" "Вчера в {s}"
"{1d:0>2}/{0d:0>2}/{2d} {3s}" "{1}.{0}.{2} {3}"
"{1s} {0d}, {2d}" "{1} {0} {2} г."
"{d} tabs" "{d} tabs"
"{d} votes" "Голосов: {d}" one="{d} голос"
